{
  "manifest_version": 3,
  "name": "eBay Tracking Collector",
  "version": "1.2.1",
  "description": "Collect eBay purchase orders and tracking numbers, then sync to fulfill.everymarket.com",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://order.ebay.com/*",
    "https://accountsettings.ebay.com/*",
    "https://signin.ebay.com/*",
    "https://fulfill.everymarket.com/*",
    "https://logging.everymarket.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "eBay Tracking Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebay.com/*",
        "https://ebay.com/*",
        "https://order.ebay.com/*",
        "https://accountsettings.ebay.com/*",
        "https://signin.ebay.com/*"
      ],
      "js": [
        "content/collector.js",
        "content/trigger-button.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
